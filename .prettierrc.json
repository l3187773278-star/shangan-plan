{
  "semi": true,
  "singleQuote": true,
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.html"],
      "options": { "printWidth": 130 }
    },
    {
      "files": ["*.md"],
      "options": { "proseWrap": "preserve" }
    }
  ]
}
